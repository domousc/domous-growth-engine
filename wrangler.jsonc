// Publicação no Cloudflare (Workers com arquivos estáticos). Publicar: npm run publicar
{
  "name": "domous-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "domous.com.br", "custom_domain": true },
    { "pattern": "www.domous.com.br", "custom_domain": true }
  ],
  "workers_dev": true
}
